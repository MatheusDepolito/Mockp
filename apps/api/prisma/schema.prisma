// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  uid          String        @id
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  name         String?
  image        String?
  Credentials  Credentials?
  AuthProvider AuthProvider?
  Admin        Admin?
  BrokerageManager BrokerageManager?
  Agent        Agent?
  Customer     Customer?
}

model Admin {
  uid  String @id
  User User   @relation(fields: [uid], references: [uid])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Verifications Verification[]
}

model Credentials {
  uid          String @id
  email        String @unique
  User         User   @relation(fields: [uid], references: [uid])
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthProvider {
  uid String @id

  type AuthProviderType
  User User             @relation(fields: [uid], references: [uid])
}

enum AuthProviderType {
  GOOGLE
  CREDENTIALS
}

model Customer {
  uid  String @id
  User User   @relation(fields: [uid], references: [uid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?

  Inquiries Inquiry[]
  Reviews   Review[]
}

model BrokerageManager {
  uid       String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?
  User        User    @relation(fields: [uid], references: [uid])

  brokerageId     Int?              @unique
  Brokerage       Brokerage?          @relation(fields: [brokerageId], references: [id])
  InquiryTimeline InquiryTimeline[]
}

model Agent {
  uid       String   @id
  createdAt DateTime @default(now())
  User      User     @relation(fields: [uid], references: [uid])
  updatedAt DateTime @updatedAt

  displayName String
  image       String?
  licenseID   String  @default("")

  brokerageId           Int?
  Brokerage             Brokerage?          @relation(fields: [brokerageId], references: [id])
  ResponsibleProperties Property[]          @relation("ResponsibleAgent")
  InquiryTimeline       InquiryTimeline[]
  AgentAssignments      AgentAssignment[]

  @@unique([brokerageId, uid])
}

model Brokerage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?
  description String?

  Properties        Property[]
  BrokerageManagers BrokerageManager[]
  Agents            Agent[]
}

model Property {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?
  description String?
  images      String[]

  propertyType PropertyType   @default(APARTMENT)
  purpose      PropertyPurpose @default(RENT)
  listPrice    Float?

  brokerageId        Int?
  responsibleAgentId String
  Brokerage          Brokerage? @relation(fields: [brokerageId], references: [id])
  ResponsibleAgent   Agent      @relation("ResponsibleAgent", fields: [responsibleAgentId], references: [uid])
  Address            Address?
  Verification       Verification?
  Reviews            Review[]
  PropertyFeatures   PropertyFeature[]
  Inquiries          Inquiry[]
}

enum PropertyType {
  HOUSE
  APARTMENT
}

enum PropertyPurpose {
  RENT
  SALE
  RENT_AND_SALE
}

model Address {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address String
  lat     Float
  lng     Float

  propertyId Int      @unique
  Property   Property @relation(fields: [propertyId], references: [id])
}

model PropertyFeature {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?
  type        PropertyFeatureType @default(OTHER)
  quantity    Int                 @default(1)

  propertyId Int
  Property   Property @relation(fields: [propertyId], references: [id])
}

enum PropertyFeatureType {
  BEDROOM
  BATHROOM
  PARKING_SPOT
  AIR_CONDITIONER
  BUILT_IN_WARDROBE
  FURNISHED_KITCHEN
  OTHER
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listPriceAtInquiry Float?
  totalPrice         Float?
  startTime          DateTime
  endTime            DateTime
  contactNotes       String?
  phoneNumber        String?
  passcode           String?
  status             InquiryStatus @default(INTERESTED)

  propertyId Int
  Property   Property @relation(fields: [propertyId], references: [id])

  customerId String
  Customer   Customer @relation(fields: [customerId], references: [uid])

  AgentAssignment AgentAssignment?
  InquiryTimeline InquiryTimeline[]

  @@index([startTime, endTime])
}

model AgentAssignment {
  inquiryId Int      @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitLat Float?
  visitLng Float?

  assignedAgentId String?
  AssignedAgent   Agent?  @relation(fields: [assignedAgentId], references: [uid])
  Inquiry         Inquiry @relation(fields: [inquiryId], references: [id])
}

model InquiryTimeline {
  id Int @id @default(autoincrement())

  timestamp DateTime      @default(now())
  status    InquiryStatus

  inquiryId Int
  agentId   String?
  managerId String?
  Inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])
  Agent     Agent?   @relation(fields: [agentId], references: [uid])
  BrokerageManager BrokerageManager? @relation(fields: [managerId], references: [uid])

  @@index([inquiryId])
}

model Review {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating  Int     @default(0)
  comment String?

  customerId String
  Customer   Customer @relation(fields: [customerId], references: [uid])

  propertyId Int
  Property   Property @relation(fields: [propertyId], references: [id])
}

model Verification {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verified Boolean @default(false)

  adminId    String
  propertyId Int    @id
  Admin      Admin  @relation(fields: [adminId], references: [uid])
  Property   Property @relation(fields: [propertyId], references: [id])
}

enum InquiryStatus {
  INTERESTED
  VISIT_SCHEDULED
  PROPOSAL
  CLOSED
}
